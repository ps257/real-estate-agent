# --- LLM (dùng cho các node cần suy luận) ---
OPENAI_API_KEY=sk-proj-xxxxxxxx
# Model mặc định cho agent. Có thể đổi.
AGENT_LLM_MODEL=gpt-5.6
# Endpoint OpenAI-compatible khác (Azure OpenAI, vLLM, OpenRouter, LiteLLM...).
# Bỏ trống = api.openai.com.
# OPENAI_BASE_URL=

# --- Guardrail tầng 2 (LLM classifier) ---
# Tầng 1 là regex (luôn chạy, không cần cấu hình). Tầng 2 chỉ chạy khi tầng 1
# không bắt được, và tự tắt nếu thiếu OPENAI_API_KEY ở trên.
GUARDRAIL_LLM_ENABLED=true
# Model riêng, KHÔNG kế thừa AGENT_LLM_MODEL — phân loại 5 nhãn nên ưu tiên
# model rẻ/nhanh. Kiểm tra tên model hiện hành trước khi đổi.
GUARDRAIL_LLM_MODEL=gpt-4o-mini
# Ngân sách latency cứng (giây). Hết giờ -> cho qua (fail-open), tức là request
# lọt lưới tầng 2 mà không có lỗi nào báo ra. Đặt quá chặt nguy hiểm hơn quá rộng.
# Đo thực tế gpt-4o-mini từ VN: warm p50 ~1.4s, p95 ~2.1s, call đầu ~3.5s.
GUARDRAIL_LLM_TIMEOUT=6.0
# Chỉ chặn khi model chắc chắn ở mức này trở lên (chống chặn nhầm câu hợp lệ).
GUARDRAIL_MIN_CONFIDENCE=0.7

# --- Intent classifier ---
# Tầng 1 là rule khớp nhãn CTA (miễn phí). Tầng 2 là LLM, chạy trên MỌI request
# không phải CTA — nên latency ở đây ảnh hưởng trực tiếp tới TTFT.
INTENT_LLM_ENABLED=true
# Bỏ trống = kế thừa AGENT_LLM_MODEL. Đo thực tế: gpt-5.6 chính xác 13/13 nhưng
# p50 ~2.8s (reasoning model); gpt-4o-mini nhanh gấp ~3 lần. Chạy
# scripts/smoke_intent.py để so chính xác/latency trước khi chốt.
INTENT_LLM_MODEL=gpt-4o-mini
# Hết giờ -> fallback US1_SEARCH (phân loại sai mà không có lỗi nào báo ra).
INTENT_LLM_TIMEOUT=10.0

# --- Entity extraction ---
# Chạy trên mọi request không bị guardrail chặn. Bỏ trống model = kế thừa
# AGENT_LLM_MODEL. Chạy scripts/smoke_entities.py để đo chính xác/latency.
ENTITIES_LLM_ENABLED=true
ENTITIES_LLM_MODEL=gpt-4o-mini
# Hết giờ -> entities rỗng -> conversation hỏi lại (an toàn, không đoán bừa).
ENTITIES_LLM_TIMEOUT=10.0

# --- MCP server: real-estate-mcp ---
# Chọn cách kết nối: "stdio" (dev, agent tự spawn) | "http" (server đã được host).
MCP_TRANSPORT=stdio

# (A) stdio — dev local: agent tự spawn server. Mặc định khớp `python -m app`.
MCP_SERVER_CMD=python
MCP_SERVER_ARGS=-m app
MCP_SERVER_CWD=../real-estate-mcp/src

# (B) http — KHI MCP SERVER ĐÃ HOST: đặt MCP_TRANSPORT=http và điền URL bên dưới.
#     (bỏ trống các biến stdio ở trên khi dùng http)
# MCP_SERVER_URL=https://mcp.your-domain.com/mcp
# Auth headers dạng "K1=V1,K2=V2" (vd Bearer token). Bỏ trống nếu server public.
# MCP_SERVER_HEADERS=Authorization=Bearer xxxxx

# --- Supabase (chỉ MCP server đọc khi chạy stdio local; host HTTP thì server tự có) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Đường dẫn skill catalog (tuỳ chọn, có default) ---
# SKILLS_DIR=src/agent/skills/catalog

# --- Server (host agent thành domain kiểu OpenAI) ---
HOST=0.0.0.0
PORT=8000
# API key để bảo vệ endpoint public (client gửi `Authorization: Bearer <key>`).
# Bỏ trống = không yêu cầu auth (chỉ nên dùng khi dev local).
# Nhiều key ngăn cách bằng dấu phẩy.
AGENT_API_KEYS=
# CORS: domain frontend được phép gọi (ngăn cách bằng phẩy, hoặc "*").
CORS_ALLOW_ORIGINS=*
# Public base URL (chỉ để hiển thị trong docs/log). Ví dụ: https://api.your-domain.com
PUBLIC_BASE_URL=http://localhost:8000
